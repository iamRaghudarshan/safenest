# Copy to `.env` and fill in real values. The app refuses to start without them.
#
#   JWT_SECRET / MEDIA_SECRET:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   VAULT_KEY_HEX:              python -c "import secrets; print(secrets.token_hex(32))"

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=finmate
DB_USER=finmate
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRE_MINUTES=480

VAULT_KEY_HEX=
# Set only while rotating away from a previous vault key; remove once migrated.
VAULT_KEY_LEGACY_HEX=

MEDIA_SECRET=
MEDIA_URL_TTL=86400

FACE_SERVICE_URL=http://127.0.0.1:8090
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Where this installation is reachable from the internet. Leave blank and the app
# still works on the local network — licences simply have nothing to check in
# against. On the publisher this is the address signed into every licence issued,
# so changing it later strands the copies already out there.
PUBLIC_BASE_URL=

# Only when the public website has its own hostname, separate from the app —
# e.g. SITE_BASE_URL=https://example.com with PUBLIC_BASE_URL=https://app.example.com.
# One origin still serves both; this decides what "/" returns, by Host. Blank
# means one address serves the website and the app, which is the normal case.
SITE_BASE_URL=
